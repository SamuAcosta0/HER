# OCR configuration
OCR_BACKEND=google
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json
TESSERACT_CMD=
OCR_CACHE_DIR=output/ocr_cache

# Browser configuration
HEADLESS=true
SLOW_MO_MS=0
NAV_TIMEOUT_MS=30000
ACTION_DELAY_MS=800
MAX_ACTION_RETRIES=5
END_CARILLAS_ATTEMPTS=3
SCREENSHOT_DIR=output/screenshots
EVIDENCE_DIR=output/evidence
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# Site configuration
BASE_URL=https://www.impo.com.uy/diariooficial/imagenes
SECTION_NAME=Avisos Publicados
SECTION_VALUE=9

# Storage and workers
DB_PATH=output/checkpoints.sqlite
OUTPUT_DIR=output
WORKERS=1
